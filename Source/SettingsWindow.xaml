<Window x:Class="SeniorDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SeniorDesktop.Localization"
        Title="{loc:Loc Settings.Title}" Width="1120" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" Topmost="True" ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="15">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ===================== TILES ===================== -->
            <TabItem Header="{loc:Loc Settings.Tab.Tiles}" FontSize="16" Padding="14,4">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- list -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="TileList" DisplayMemberPath="Title" FontSize="17" SelectionChanged="TileList_SelectionChanged"/>
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button Style="{StaticResource Btn}" Content="{loc:Loc Settings.Tiles.Add}" Click="AddTile_Click"/>
                            <Button Style="{StaticResource Btn}" Content="{loc:Loc Settings.Tiles.FromStart}" Click="AddFromStart_Click"/>
                            <Button Style="{StaticResource Btn}" Content="▲" Click="MoveUp_Click" ToolTip="{loc:Loc Settings.Tiles.MoveUp}"/>
                            <Button Style="{StaticResource Btn}" Content="▼" Click="MoveDown_Click" ToolTip="{loc:Loc Settings.Tiles.MoveDown}"/>
                            <Button Style="{StaticResource Btn}" Content="{loc:Loc Settings.Tiles.Remove}" Click="RemoveTile_Click"/>
                        </WrapPanel>
                    </Grid>

                    <!-- form + preview -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
                        <Grid x:Name="TileForm" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.Tile.Name}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="17" Padding="4"/>

                                <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.Tile.Target}"/>
                                <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource Btn}" Content="{loc:Loc Settings.Tile.BrowseFile}" Click="BrowseTarget_Click"/>
                                    <Button Style="{StaticResource Btn}" Content="{loc:Loc Settings.Tile.BrowseFolder}" Click="BrowseFolder_Click"/>
                                </WrapPanel>

                                <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.Tile.Arguments}"/>
                                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>

                                <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.Tile.Icon}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{loc:Loc Settings.Tile.IconHint}"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="6,0,0,0" Content="{loc:Loc Settings.Tile.IconClear}" Click="ClearIcon_Click"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="6,0,0,0" Content="{loc:Loc Settings.Tile.IconBrowse}" Click="BrowseIcon_Click"/>
                                    <TextBox Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" Padding="4" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.Tile.Symbol}" FontWeight="Normal"/>
                                <WrapPanel x:Name="EmojiPanel"/>

                                <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.Tile.Color}"/>
                                <WrapPanel x:Name="TileColorPanel"/>

                                <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.Tile.CustomSize}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}" Width="90" Padding="4" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Settings.Tile.CustomSizeHint}"/>
                                </StackPanel>

                                <CheckBox Margin="0,16,0,0" FontSize="16" IsChecked="{Binding Maximize}"
                                          Content="{loc:Loc Settings.Tile.Maximize}"/>

                                <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.Tile.SpeakText}"/>
                                <TextBox Text="{Binding SpeakText, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="4"/>
                                <Button Style="{StaticResource Btn}" Margin="0,6,0,0" HorizontalAlignment="Left" Content="{loc:Loc Settings.Tile.Listen}" Click="SpeakTest_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.Tile.Preview}" Margin="0,0,0,3"/>
                                <Border x:Name="PreviewBorder" CornerRadius="10" Height="330" Background="#0F2A47">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="6">
                                        <ContentControl x:Name="PreviewHost" Focusable="False" IsHitTestVisible="False"/>
                                    </Viewbox>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===================== GENERAL ===================== -->
            <TabItem Header="{loc:Loc Settings.Tab.General}" FontSize="16" Padding="14,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GeneralTab" Margin="20,8,20,20" MaxWidth="680">

                        <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.General.TileSize}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SizeSlider" Minimum="120" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding TileSize, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0} px}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.General.Spacing}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SpacingSlider" Minimum="0" Maximum="60" TickFrequency="2" IsSnapToTickEnabled="True"
                                    Value="{Binding TileSpacing, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="{Binding Value, ElementName=SpacingSlider, StringFormat={}{0:0} px}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.General.LabelFont}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <Slider x:Name="FontSlider" Minimum="12" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding LabelFontSize, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="{Binding Value, ElementName=FontSlider, StringFormat={}{0:0} pt}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.General.Background}"/>
                        <WrapPanel x:Name="BackgroundPanel"/>

                        <CheckBox Margin="0,16,0,0" IsChecked="{Binding ShowClock}" Content="{loc:Loc Settings.General.ShowClock}"/>

                        <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.General.TimeFont}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <Slider x:Name="TimeFontSlider" Minimum="24" Maximum="200" TickFrequency="2" IsSnapToTickEnabled="True"
                                    Value="{Binding TimeFontSize, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="{Binding Value, ElementName=TimeFontSlider, StringFormat={}{0:0} pt}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.General.WeekdayFont}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <Slider x:Name="WeekdayFontSlider" Minimum="14" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding WeekdayFontSize, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="{Binding Value, ElementName=WeekdayFontSlider, StringFormat={}{0:0} pt}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.General.DateFont}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <Slider x:Name="DateFontSlider" Minimum="14" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding DateFontSize, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="{Binding Value, ElementName=DateFontSlider, StringFormat={}{0:0} pt}"/>
                        </Grid>
                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding Autostart}" Content="{loc:Loc Settings.General.Autostart}"/>

                        <Separator Margin="0,20"/>

                        <CheckBox IsChecked="{Binding SpeechEnabled}" Content="{loc:Loc Settings.General.SpeechEnabled}"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.General.Voice}"/>
                        <ComboBox x:Name="VoiceBox" SelectionChanged="VoiceBox_SelectionChanged" Padding="6"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{loc:Loc Settings.General.VoiceHint}"/>

                        <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.General.Rate}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <Slider x:Name="RateSlider" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SpeechRate, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="{Binding Value, ElementName=RateSlider, StringFormat={}{0:0}}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Lbl}" Text="{loc:Loc Settings.General.Volume}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding SpeechVolume, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:0} %}"/>
                        </Grid>
                        <Button Style="{StaticResource Btn}" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{loc:Loc Settings.General.VoiceTest}" Click="VoiceTest_Click"/>

                        <Separator Margin="0,20"/>

                        <WrapPanel>
                            <Button Style="{StaticResource Btn}" Content="{loc:Loc Settings.General.OpenFolder}" Click="OpenFolder_Click"/>
                            <Button Style="{StaticResource Btn}" Content="{loc:Loc Settings.General.Exit}" Click="ExitOverlay_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== LANGUAGE (flags only, no text) ===================== -->
            <TabItem ToolTip="{loc:Loc Settings.Tab.Language.ToolTip}" Padding="12,4">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="2,2">
                        <loc:Flag Code="pl" Width="30" Height="20"/>
                        <loc:Flag Code="gb" Width="30" Height="20" Margin="6,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel x:Name="LanguageTab" Margin="20,8,20,20">
                    <TextBlock Style="{StaticResource Lbl}" FontSize="18" Text="{loc:Loc Settings.Language.Heading}"/>

                    <ListBox x:Name="LanguageList" Margin="0,10,0,0" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding Languages, Source={x:Static loc:Loc.Instance}}"
                             SelectedValuePath="Code"
                             SelectedValue="{Binding Language, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,18,18"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Width="190" Padding="14,14,14,12" CornerRadius="14"
                                                    BorderThickness="4" BorderBrush="#D5D5D5" Background="White">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#7AA7E8"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#1F6FEB"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#EAF2FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <loc:Flag Code="{Binding Flag}" Width="132" Height="88" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" MaxWidth="700" HorizontalAlignment="Left"
                               Text="{loc:Loc Settings.Language.Hint}"/>
                    <Button Style="{StaticResource Btn}" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Content="{loc:Loc Settings.Language.OpenFolder}" Click="OpenLanguagesFolder_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Loc Settings.Button.OK}" FontSize="17" Padding="26,9" Margin="0,0,10,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="{loc:Loc Settings.Button.Apply}" FontSize="17" Padding="26,9" Margin="0,0,10,0" Click="Apply_Click"/>
            <Button Content="{loc:Loc Settings.Button.Cancel}" FontSize="17" Padding="26,9" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
